{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:review-cockpit:schema:review-document:1",
  "title": "ReviewDocument",
  "description": "One review document per pull request. The analyzer writes stage 1, the judgment merge writes stage 2, the graph stage writes stage 3. Unknown fields are allowed everywhere and are reported as warnings.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "generatedAt",
    "tool",
    "pr",
    "checkout",
    "status",
    "files",
    "comments",
    "checks",
    "groups",
    "path",
    "summary",
    "graph"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "tool": { "$ref": "#/$defs/ToolInfo" },
    "pr": { "$ref": "#/$defs/PrInfo" },
    "checkout": { "$ref": "#/$defs/CheckoutInfo" },
    "status": { "$ref": "#/$defs/DocumentStatus" },
    "files": { "type": "array", "items": { "$ref": "#/$defs/ReviewFile" } },
    "comments": { "type": "array", "items": { "$ref": "#/$defs/Comment" } },
    "checks": { "type": "array", "items": { "$ref": "#/$defs/Check" } },
    "groups": { "type": "array", "items": { "$ref": "#/$defs/Group" } },
    "path": { "type": "array", "items": { "$ref": "#/$defs/PathStep" } },
    "summary": { "$ref": "#/$defs/Summary" },
    "graph": { "$ref": "#/$defs/Graph" }
  },
  "$defs": {
    "ToolInfo": {
      "title": "ToolInfo",
      "type": "object",
      "additionalProperties": true,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" }
      }
    },

    "GitRef": {
      "title": "GitRef",
      "type": "object",
      "additionalProperties": true,
      "required": ["ref", "sha"],
      "properties": {
        "ref": { "type": "string" },
        "sha": { "type": "string" }
      }
    },

    "PrInfo": {
      "title": "PrInfo",
      "type": "object",
      "additionalProperties": true,
      "required": [
        "owner",
        "repo",
        "number",
        "url",
        "title",
        "body",
        "author",
        "draft",
        "labels",
        "base",
        "head",
        "additions",
        "deletions",
        "changedFiles"
      ],
      "properties": {
        "owner": { "type": "string", "minLength": 1 },
        "repo": { "type": "string", "minLength": 1 },
        "number": { "type": "integer", "minimum": 1 },
        "url": { "type": "string", "format": "uri" },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "author": { "type": "string" },
        "draft": { "type": "boolean" },
        "labels": { "type": "array", "items": { "type": "string" } },
        "base": { "$ref": "#/$defs/GitRef" },
        "head": { "$ref": "#/$defs/GitRef" },
        "additions": { "type": "integer", "minimum": 0 },
        "deletions": { "type": "integer", "minimum": 0 },
        "changedFiles": { "type": "integer", "minimum": 0 }
      }
    },

    "CheckoutInfo": {
      "title": "CheckoutInfo",
      "description": "sourceRepo is the local clone a worktree was added to. It is absent for mode \"clone\".",
      "type": "object",
      "additionalProperties": true,
      "required": ["mode", "path"],
      "properties": {
        "mode": { "enum": ["worktree", "clone"] },
        "path": { "type": "string", "minLength": 1 },
        "sourceRepo": { "type": "string", "minLength": 1 }
      }
    },

    "SectionState": {
      "title": "SectionState",
      "enum": ["pending", "ready", "failed"]
    },

    "SectionStatus": {
      "title": "SectionStatus",
      "description": "message is required when state is failed and is shown to the reviewer as written.",
      "type": "object",
      "additionalProperties": true,
      "required": ["state", "updatedAt"],
      "properties": {
        "state": { "$ref": "#/$defs/SectionState" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "message": { "type": "string" }
      }
    },

    "DocumentStatus": {
      "title": "DocumentStatus",
      "type": "object",
      "additionalProperties": true,
      "required": ["files", "comments", "checks", "groups", "path", "summary", "graph"],
      "properties": {
        "files": { "$ref": "#/$defs/SectionStatus" },
        "comments": { "$ref": "#/$defs/SectionStatus" },
        "checks": { "$ref": "#/$defs/SectionStatus" },
        "groups": { "$ref": "#/$defs/SectionStatus" },
        "path": { "$ref": "#/$defs/SectionStatus" },
        "summary": { "$ref": "#/$defs/SectionStatus" },
        "graph": { "$ref": "#/$defs/SectionStatus" }
      }
    },

    "FileStatus": {
      "title": "FileStatus",
      "enum": ["added", "modified", "deleted", "renamed"]
    },

    "Language": {
      "title": "Language",
      "enum": ["go", "typescript", "tsx", "python", "proto", "yaml", "json", "markdown", "other"]
    },

    "GeneratedInfo": {
      "title": "GeneratedInfo",
      "description": "rule names the pattern that folded the file, so the reviewer can see why.",
      "type": "object",
      "additionalProperties": true,
      "required": ["is", "rule"],
      "properties": {
        "is": { "type": "boolean" },
        "rule": { "type": ["string", "null"] }
      }
    },

    "SensitivePathInfo": {
      "title": "SensitivePathInfo",
      "type": "object",
      "additionalProperties": true,
      "required": ["match", "rule"],
      "properties": {
        "match": { "type": "boolean" },
        "rule": { "type": ["string", "null"] }
      }
    },

    "FileSignals": {
      "title": "FileSignals",
      "description": "Raw deterministic measurements for one file. null means the signal could not be computed and is never treated as zero.",
      "type": "object",
      "additionalProperties": true,
      "required": [
        "churnCommits90d",
        "bugfixCommits",
        "authorPriorCommits",
        "fanIn",
        "fanOut",
        "fanSource",
        "complexityBefore",
        "complexityAfter",
        "sensitivePath",
        "testFile",
        "coverageDelta"
      ],
      "properties": {
        "churnCommits90d": { "type": ["integer", "null"], "minimum": 0 },
        "bugfixCommits": { "type": ["integer", "null"], "minimum": 0 },
        "authorPriorCommits": { "type": ["integer", "null"], "minimum": 0 },
        "fanIn": { "type": ["integer", "null"], "minimum": 0 },
        "fanOut": { "type": ["integer", "null"], "minimum": 0 },
        "fanSource": {
          "description": "Where fanIn and fanOut came from. null when neither could be computed.",
          "type": ["string", "null"],
          "enum": ["grep", "graph", null]
        },
        "complexityBefore": { "type": ["integer", "null"], "minimum": 0 },
        "complexityAfter": { "type": ["integer", "null"], "minimum": 0 },
        "sensitivePath": { "$ref": "#/$defs/SensitivePathInfo" },
        "testFile": { "type": "boolean" },
        "coverageDelta": { "type": ["number", "null"] }
      }
    },

    "RiskLevel": {
      "title": "RiskLevel",
      "enum": ["low", "medium", "high"]
    },

    "ReviewMode": {
      "title": "ReviewMode",
      "description": "Reading depth. It follows risk.level and does not control expansion; collapsedByDefault does.",
      "enum": ["skim", "scrutinize"]
    },

    "RiskFactor": {
      "title": "RiskFactor",
      "type": "object",
      "additionalProperties": true,
      "required": ["signal", "contribution", "detail"],
      "properties": {
        "signal": { "type": "string" },
        "contribution": { "type": "number" },
        "detail": { "type": "string" }
      }
    },

    "RiskAdjustment": {
      "title": "RiskAdjustment",
      "description": "Set when the judgment pass raised a hunk above its floor.",
      "type": "object",
      "additionalProperties": true,
      "required": ["from", "to", "why"],
      "properties": {
        "from": { "$ref": "#/$defs/RiskLevel" },
        "to": { "$ref": "#/$defs/RiskLevel" },
        "why": { "type": "string" }
      }
    },

    "Risk": {
      "title": "Risk",
      "type": "object",
      "additionalProperties": true,
      "required": ["floor", "level", "score", "mode", "factors", "reason", "adjustedBy"],
      "properties": {
        "floor": { "$ref": "#/$defs/RiskLevel" },
        "level": { "$ref": "#/$defs/RiskLevel" },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "mode": { "$ref": "#/$defs/ReviewMode" },
        "factors": { "type": "array", "items": { "$ref": "#/$defs/RiskFactor" } },
        "reason": { "type": ["string", "null"] },
        "adjustedBy": {
          "anyOf": [{ "$ref": "#/$defs/RiskAdjustment" }, { "type": "null" }]
        }
      }
    },

    "DiffLineType": {
      "title": "DiffLineType",
      "enum": ["context", "add", "del"]
    },

    "DiffLine": {
      "title": "DiffLine",
      "description": "oldNo is null on an added line, newNo is null on a deleted line.",
      "type": "object",
      "additionalProperties": true,
      "required": ["type", "oldNo", "newNo", "text"],
      "properties": {
        "type": { "$ref": "#/$defs/DiffLineType" },
        "oldNo": { "type": ["integer", "null"], "minimum": 1 },
        "newNo": { "type": ["integer", "null"], "minimum": 1 },
        "text": { "type": "string" }
      }
    },

    "HunkKind": {
      "title": "HunkKind",
      "enum": ["code", "import", "test", "comment-only", "whitespace-only"]
    },

    "Hunk": {
      "title": "Hunk",
      "description": "id is <fileId>.h<index>, where index counts hunks within the file from 1.",
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "oldStart",
        "oldLines",
        "newStart",
        "newLines",
        "header",
        "symbols",
        "kind",
        "lines",
        "risk"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "oldStart": { "type": "integer", "minimum": 0 },
        "oldLines": { "type": "integer", "minimum": 0 },
        "newStart": { "type": "integer", "minimum": 0 },
        "newLines": { "type": "integer", "minimum": 0 },
        "header": { "type": "string" },
        "symbols": { "type": "array", "items": { "type": "string" } },
        "kind": { "$ref": "#/$defs/HunkKind" },
        "lines": { "type": "array", "items": { "$ref": "#/$defs/DiffLine" } },
        "risk": { "$ref": "#/$defs/Risk" }
      }
    },

    "ReviewFile": {
      "title": "ReviewFile",
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "path",
        "previousPath",
        "status",
        "language",
        "binary",
        "generated",
        "additions",
        "deletions",
        "signals",
        "hunks"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "previousPath": { "type": ["string", "null"] },
        "status": { "$ref": "#/$defs/FileStatus" },
        "language": { "$ref": "#/$defs/Language" },
        "binary": { "type": "boolean" },
        "generated": { "$ref": "#/$defs/GeneratedInfo" },
        "additions": { "type": "integer", "minimum": 0 },
        "deletions": { "type": "integer", "minimum": 0 },
        "signals": { "$ref": "#/$defs/FileSignals" },
        "hunks": { "type": "array", "items": { "$ref": "#/$defs/Hunk" } }
      }
    },

    "Side": {
      "title": "Side",
      "description": "LEFT is the base side, RIGHT the head side, exactly as GitHub's review API expects.",
      "enum": ["LEFT", "RIGHT"]
    },

    "CommentSource": {
      "title": "CommentSource",
      "type": "object",
      "additionalProperties": true,
      "required": ["kind", "name"],
      "properties": {
        "kind": { "enum": ["bot", "human"] },
        "name": { "type": "string" }
      }
    },

    "Comment": {
      "title": "Comment",
      "description": "hunkId is null when the comment sits on a line outside the current diff.",
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "source",
        "author",
        "path",
        "line",
        "side",
        "hunkId",
        "body",
        "url",
        "createdAt",
        "resolved",
        "severity"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/$defs/CommentSource" },
        "author": { "type": "string" },
        "path": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "side": { "$ref": "#/$defs/Side" },
        "hunkId": { "type": ["string", "null"] },
        "body": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "createdAt": { "type": "string", "format": "date-time" },
        "resolved": { "type": "boolean" },
        "severity": { "type": ["string", "null"], "enum": ["low", "medium", "high", null] }
      }
    },

    "CheckStatus": {
      "title": "CheckStatus",
      "enum": ["success", "failure", "pending", "neutral", "skipped", "cancelled"]
    },

    "Check": {
      "title": "Check",
      "type": "object",
      "additionalProperties": true,
      "required": ["name", "app", "status", "url", "completedAt"],
      "properties": {
        "name": { "type": "string" },
        "app": { "type": "string" },
        "status": { "$ref": "#/$defs/CheckStatus" },
        "url": { "type": "string", "format": "uri" },
        "completedAt": { "type": ["string", "null"], "format": "date-time" }
      }
    },

    "GroupKind": {
      "title": "GroupKind",
      "enum": [
        "generated",
        "import",
        "whitespace",
        "mechanical-rename",
        "formatting",
        "test-update",
        "semantic"
      ]
    },

    "Group": {
      "title": "Group",
      "description": "A set of hunks the reviewer treats as one thing. collapsedByDefault is the only field that controls expansion.",
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "kind",
        "title",
        "description",
        "hunkIds",
        "mode",
        "collapsedByDefault",
        "producedBy"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "$ref": "#/$defs/GroupKind" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "hunkIds": { "type": "array", "items": { "type": "string" } },
        "mode": { "$ref": "#/$defs/ReviewMode" },
        "collapsedByDefault": { "type": "boolean" },
        "producedBy": { "enum": ["stage1", "stage2"] }
      }
    },

    "Phase": {
      "title": "Phase",
      "enum": ["models", "core", "callsites", "tests", "config", "other"]
    },

    "PathRef": {
      "title": "PathRef",
      "type": "object",
      "additionalProperties": true,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "enum": ["hunk", "group"] },
        "id": { "type": "string", "minLength": 1 }
      }
    },

    "PathStep": {
      "title": "PathStep",
      "type": "object",
      "additionalProperties": true,
      "required": ["step", "ref", "phase", "note"],
      "properties": {
        "step": { "type": "integer", "minimum": 1 },
        "ref": { "$ref": "#/$defs/PathRef" },
        "phase": { "$ref": "#/$defs/Phase" },
        "note": { "type": ["string", "null"] }
      }
    },

    "SummaryCounts": {
      "title": "SummaryCounts",
      "description": "Recomputed from the document at merge, never taken from the judgment file.",
      "type": "object",
      "additionalProperties": true,
      "required": ["hunks", "highRisk", "skimmable"],
      "properties": {
        "hunks": { "type": "integer", "minimum": 0 },
        "highRisk": { "type": "integer", "minimum": 0 },
        "skimmable": { "type": "integer", "minimum": 0 }
      }
    },

    "Summary": {
      "title": "Summary",
      "description": "Empty until the judgment merge runs. The validator requires all three fields once status.summary is ready.",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "oneLiner": { "type": "string" },
        "reviewFocus": { "type": "array", "items": { "type": "string" } },
        "counts": { "$ref": "#/$defs/SummaryCounts" }
      }
    },

    "GraphNode": {
      "title": "GraphNode",
      "description": "hunkIds is the click target. Unchanged neighbours carry an empty list.",
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "kind", "label", "file", "changed", "hunkIds"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["function", "file", "package"] },
        "label": { "type": "string" },
        "file": { "type": ["string", "null"] },
        "changed": { "type": "boolean" },
        "hunkIds": { "type": "array", "items": { "type": "string" } }
      }
    },

    "GraphEdge": {
      "title": "GraphEdge",
      "type": "object",
      "additionalProperties": true,
      "required": ["from", "to", "kind"],
      "properties": {
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["calls", "imports"] }
      }
    },

    "Graph": {
      "title": "Graph",
      "description": "The blast-radius map. Capped at 300 nodes; truncated says the cap was hit.",
      "type": "object",
      "additionalProperties": true,
      "required": ["nodes", "edges", "truncated"],
      "properties": {
        "nodes": { "type": "array", "maxItems": 300, "items": { "$ref": "#/$defs/GraphNode" } },
        "edges": { "type": "array", "items": { "$ref": "#/$defs/GraphEdge" } },
        "truncated": { "type": "boolean" }
      }
    }
  }
}
