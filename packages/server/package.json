{
  "name": "@review-cockpit/server",
  "private": true,
  "version": "0.1.0",
  "description": "The local HTTP server that serves the cockpit, the review document and its change events.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@review-cockpit/schema": "0.1.0"
  },
  "devDependencies": {
    "vitest": "^3.2.7"
  }
}
